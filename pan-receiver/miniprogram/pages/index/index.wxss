.container {
  padding: 20rpx;
}
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}
.title {
  font-size: 36rpx;
  font-weight: bold;
}
.create-btn {
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  padding: 10rpx 24rpx;
  border-radius: 8rpx;
}
.task-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.task-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.task-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}
.task-meta {
  display: flex;
  gap: 24rpx;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.task-status {
  display: inline-block;
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.task-status.active {
  background: #e6f7ed;
  color: #07c160;
}
.empty {
  text-align: center;
  color: #999;
  margin-top: 100rpx;
}