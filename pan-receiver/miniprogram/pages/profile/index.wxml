<view class="container">
  <view class="user-card">
    <view class="avatar">
      <open-data type="userAvatarUrl"></open-data>
    </view>
    <view class="info">
      <open-data type="userNickName"></open-data>
    </view>
  </view>

  <view class="bind-section">
    <view class="bind-status">
      <text>百度网盘：{{baiduBound ? '已绑定' : '未绑定'}}</text>
    </view>
    <button wx:if="{{!baiduBound}}" class="btn-primary" bindtap="bindBaidu">
      绑定百度网盘
    </button>
    <button wx:if="{{baiduBound}}" class="btn-default" bindtap="unbindBaidu">
      解绑百度网盘
    </button>
  </view>
</view>
