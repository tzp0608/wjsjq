.container {
  padding: 30rpx;
}
.task-info {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}
.task-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}
.task-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}
.task-meta {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: #999;
}
.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 30rpx;
}
.action-btn {
  background: #f5f5f5;
  color: #333;
}
.file-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}
.file-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}
.file-name {
  font-size: 28rpx;
  color: #333;
}
.file-size {
  font-size: 24rpx;
  color: #999;
}
.status {
  margin-top: 30rpx;
  font-size: 26rpx;
  color: #666;
}
.bind-tip {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  text-align: center;
}
.bind-tip text {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
}
