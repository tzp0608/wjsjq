APP_ENV=development
APP_BASE_URL=http://localhost:3000
APP_PORT=3000

JWT_SECRET=your_random_32_chars_string_here
JWT_EXPIRES_IN=7d

DATABASE_URL=postgresql://panreceiver:panreceiver_secret@localhost:5432/pan_receiver
REDIS_URL=redis://localhost:6379

WECHAT_APP_ID=your_wechat_appid
WECHAT_APP_SECRET=your_wechat_appsecret

BAIDU_APP_KEY=your_baidu_app_key
BAIDU_APP_SECRET=your_baidu_app_secret
BAIDU_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/baidu/callback

TOKEN_ENCRYPTION_KEY=your_32_bytes_encryption_key
TEMP_FILE_DIR=/tmp/pan-receiver

MAX_FILE_SIZE=524288000
MAX_FILE_COUNT_PER_SUBMISSION=20
